{
  // Configuração do PROCESSO PRINCIPAL do Electron (electron/) e do vite.config.ts.
  // Esse código roda no Node, com acesso a disco e rede.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["electron", "vite.config.ts"]
}
