    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^1.2.0"
  }
}
