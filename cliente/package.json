{
  "name": "lancer-cliente",
  "version": "0.1.0",
  "description": "App desktop do LANcer Chat",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
